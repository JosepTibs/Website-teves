{% extends 'base.html.twig' %}

{% block title %}Make a Reservation{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 py-10">
  <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow">
    <h1 class="text-3xl font-semibold mb-6 text-center text-[var(--brand-gold)]">Make a Reservation</h1>

    <form class="space-y-6">
      <div>
        <label class="block text-gray-600 mb-2 font-medium">Full Name</label>
        <input type="text" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-[var(--brand-gold)]" placeholder="Enter your name" required>
      </div>

      <div>
        <label class="block text-gray-600 mb-2 font-medium">Email</label>
        <input type="email" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-[var(--brand-gold)]" placeholder="Enter your email" required>
      </div>

      <div>
        <label class="block text-gray-600 mb-2 font-medium">Date</label>
        <input type="date" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-[var(--brand-gold)]" required>
      </div>

      <div>
        <label class="block text-gray-600 mb-2 font-medium">Time</label>
        <input type="time" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-[var(--brand-gold)]" required>
      </div>

      <div>
        <label class="block text-gray-600 mb-2 font-medium">Number of Guests</label>
        <input type="number" min="1" max="10" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-[var(--brand-gold)]" placeholder="e.g. 4" required>
      </div>

      <div class="text-center">
        <button type="submit" class="px-6 py-3 bg-[var(--brand-gold)] text-white font-semibold rounded-lg shadow hover:opacity-90 transition">
          Submit Reservation
        </button>
      </div>
    </form>
  </div>
</main>
{% endblock %}
