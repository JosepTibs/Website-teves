{% extends 'base.html.twig' %}

{% block title %}Edit Users{% endblock %}

{% block body %}

<style>
  

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 20px;
        margin-bottom: 20px;
    }

    .form-grid label {
        font-weight: bold;
        margin-bottom: 5px;
        display: block;
        color: #444;
    }

    .form-grid input, .form-grid select {
        width: 100%;
        padding: 10px;
        border: 1px solid #bbb;
        border-radius: 5px;
        font-size: 14px;
    }

    .btn-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .btn-actions a,
    .btn-actions button {
        padding: 10px 20px;
        border-radius: 6px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-update {
        background-color: #28a745;
        color: white;
    }
    .btn-update:hover {
        background-color: #218838;
    }

    .btn-back {
        background-color: #007bff;
        color: white;
    }
    .btn-back:hover {
        background-color: #0069d9;
    }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }
    .btn-delete:hover {
        background-color: #c82333;
    }
</style>

<div class="edit-container">
    <h1>Edit Users</h1>

   <div class="form-grid">
    {{ include('users/_form.html.twig', {'button_label': 'Update'}) }}
</div>

<div class="btn-actions">
    <a href="{{ path('app_users_index') }}" class="btn-back">⬅ Back to list</a>
    {{ include('users/_delete_form.html.twig', {'button_class': 'btn-delete'}) }}
</div>

</div>

{% endblock %}
