{% extends 'Staff/base_staff.html.twig' %}

{% block title %}Staff Menu Management — Le Fromage{% endblock %}

{% block body %}
<style>
  select {
    background-color: var(--bg-input);
    color: var(--text-light);
  }

  option {
    background-color: var(--bg-darker);
    color: var(--text-light);
  }
</style>

<div class="text-center mb-10">
  <h1 class="text-4xl font-semibold text-[var(--brand-gold)] tracking-widest uppercase mb-2">
    Menu Management
  </h1>
  <p class="text-[var(--text-muted)] text-sm">Add, update, or manage dishes in each category.</p>
</div>

<!-- Add Dish Form -->
<div class="card p-6 mb-10">
  <h2 class="text-2xl text-[var(--brand-gold)] font-semibold mb-4">Add a New Dish</h2>

  {{ form_start(form, {'attr': {'class': 'grid grid-cols-1 sm:grid-cols-2 gap-6'}}) }}
    <div>
      {{ form_label(form.name, 'Dish Name', {'label_attr': {'class': 'block text-sm text-[var(--text-light)] mb-2'}}) }}
      {{ form_widget(form.name, {'attr': {'class': 'w-full rounded-lg bg-[var(--bg-input)] border border-[var(--brand-gold)]/30 p-3 text-[var(--text-light)]'}}) }}
    </div>

    <div>
      {{ form_label(form.price, 'Price (₱)', {
        'label_attr': {'class': 'block text-sm text-[var(--text-light)] mb-2'}
      }) }}
      {{ form_widget(form.price, {
        'attr': {
          'type': 'number',
          'min': '0',
          'step': '0.01',
          'class': 'w-full rounded-lg bg-[var(--bg-input)] border border-[var(--brand-gold)]/30 p-3 text-[var(--text-light)]',
          'placeholder': 'Enter price'
        }
      }) }}
    </div>

    <div class="sm:col-span-2">
      {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm text-[var(--text-light)] mb-2'}}) }}
      {{ form_widget(form.description, {'attr': {'rows': '3', 'class': 'w-full rounded-lg bg-[var(--bg-input)] border border-[var(--brand-gold)]/30 p-3 text-[var(--text-light)]'}}) }}
    </div>

    <div>
      {{ form_label(form.category, 'Category', {'label_attr': {'class': 'block text-sm text-[var(--text-light)] mb-2'}}) }}
      {{ form_widget(form.category, {'attr': {'class': 'w-full rounded-lg bg-[var(--bg-input)] border border-[var(--brand-gold)]/30 p-3 text-[var(--text-light)]'}}) }}
    </div>

    <div>
      {{ form_label(form.image, 'Image', {'label_attr': {'class': 'block text-sm text-[var(--text-light)] mb-2'}}) }}
      {{ form_widget(form.image, {'attr': {'class': 'w-full text-[var(--text-light)] border border-[var(--brand-gold)]/30 rounded-lg p-2 bg-[var(--bg-input)]'}}) }}
    </div>

    <div class="sm:col-span-2 text-right">
      <button type="submit" class="bg-[var(--brand-gold)] hover:bg-yellow-500 text-black font-semibold py-2 px-6 rounded-lg transition">
        Add Dish
      </button>
    </div>
  {{ form_end(form) }}
</div>

<!-- Dishes Display -->
<div id="menuList" class="space-y-10">
  <h2 class="text-2xl text-[var(--brand-gold)] font-semibold mb-4 border-b border-[var(--brand-gold)]/30 pb-2">
    Current Dishes
  </h2>
  <p class="text-[var(--text-muted)] mb-6">All added dishes appear below.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for dish in dishes %}
      <div class="group rounded-xl overflow-hidden border border-[var(--brand-gold)]/20 shadow-lg bg-[var(--bg-darker)] hover:shadow-[0_0_15px_rgba(212,175,55,0.3)] transition duration-300">
        <div class="h-48 w-full overflow-hidden">
      {% if dish.image %}
        <img src="{{ asset('uploads/images/' ~ dish.image) }}" alt="{{ dish.name }}" class="w-full h-48 object-cover rounded-lg mb-4">
      {% else %}
        <img src="{{ asset('images/placeholder.png') }}" alt="No image" class="w-full h-48 object-cover rounded-lg mb-4">
      {% endif %}

        </div>
        <div class="p-5 text-left">
          <h2 class="text-[var(--brand-gold)] text-xl font-semibold mb-1">{{ dish.name }}</h2>
          <p class="text-[var(--text-muted)] text-sm mb-2">{{ dish.description }}</p>
          <p class="text-[var(--brand-gold)] text-sm mb-3">Category: {{ dish.category }}</p>
          <div class="flex justify-between items-center">
            <span class="text-[var(--brand-gold)] font-semibold">₱{{ dish.price|number_format(2, '.', ',') }}</span>
            <div class="flex gap-2">
              <a href="{{ path('dish_edit', {'id': dish.id}) }}" class="text-xs bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded">Edit</a>
              <a href="{{ path('dish_delete', {'id': dish.id}) }}" class="text-xs bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded" onclick="return confirm('Are you sure you want to delete this dish?');">Delete</a>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <p class="text-[var(--text-muted)]">No dishes added yet.</p>
    {% endfor %}
  </div>
</div>

{% endblock %}
