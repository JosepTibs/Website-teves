{% extends 'Staff/base_staff.html.twig' %}

{% block title %}Staff Orders — Le Fromage{% endblock %}

{% block body %}
<section class="p-10">
  <h1 class="text-3xl font-semibold text-[var(--brand-gold)] mb-8 tracking-wide text-center uppercase">
    Manage Orders
  </h1>

  {% for message in app.flashes('success') %}
    <div class="mb-4 bg-green-600/20 border border-green-400 text-green-300 px-4 py-2 rounded">
      {{ message }}
    </div>
  {% endfor %}

  <div class="bg-gray-950 p-8 rounded-2xl border border-[var(--brand-gold)]/30 shadow-lg">
    <table id="ordersTable" class="min-w-full text-sm text-[var(--brand-gold)]">
      <thead>
        <tr class="border-b border-[var(--brand-gold)]/30 text-[var(--brand-gold)] uppercase text-xs tracking-wider">
          <th class="px-4 py-3 text-left">#</th>
          <th class="px-4 py-3 text-left">Created At</th>
          <th class="px-4 py-3 text-left">Dishes</th>
          <th class="px-4 py-3 text-left">Total (₱)</th>
          <th class="px-4 py-3 text-left">Status</th>
          <th class="px-4 py-3 text-center">Action</th>
        </tr>
      </thead>
      <tbody>
        {% for order in orders %}
          <tr class="border-b border-[var(--brand-gold)]/20 hover:bg-gray-800/50">
            <td class="px-4 py-3">{{ order.id }}</td>
            <td class="px-4 py-3">{{ order.createdAt|date('Y-m-d H:i') }}</td>
            <td class="px-4 py-3">
              {% for dish in order.dishes %}
                {{ dish.name }}{% if not loop.last %}, {% endif %}
              {% endfor %}
            </td>
            <td class="px-4 py-3">{{ order.totalPrice|number_format(2, '.', ',') }}</td>
            <td class="px-4 py-3">
              <span class="
                px-3 py-1 rounded-full text-xs font-medium
                {% if order.status == 'Pending' %}
                  bg-yellow-600/20 text-yellow-400
                {% elseif order.status == 'Delivering' %}
                  bg-blue-600/20 text-blue-400
                {% elseif order.status == 'Delivered' %}
                  bg-green-600/20 text-green-400
                {% elseif order.status == 'Cancelled' %}
                  bg-red-600/20 text-red-400
                {% endif %}
              ">
                {{ order.status }}
              </span>
            </td>
            <td class="px-4 py-3 text-center">
              <form method="post" action="{{ path('staff_orders_index') }}">
                <input type="hidden" name="order_id" value="{{ order.id }}">
                <select name="status"
                        class="bg-gray-950 border border-[var(--brand-gold)]/40 text-[var(--brand-gold)] text-sm rounded-md px-2 py-1 focus:outline-none">
                  <option value="Pending" {{ order.status == 'Pending' ? 'selected' : '' }}>Pending</option>
                  <option value="Delivering" {{ order.status == 'Delivering' ? 'selected' : '' }}>Delivering</option>
                  <option value="Delivered" {{ order.status == 'Delivered' ? 'selected' : '' }}>Delivered</option>
                  <option value="Cancelled" {{ order.status == 'Cancelled' ? 'selected' : '' }}>Cancelled</option>
                </select>
                <button type="submit"
                        class="ml-2 bg-[var(--brand-gold)] hover:bg-yellow-600 text-black font-semibold px-4 py-1 rounded-md text-sm">
                  Update
                </button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="px-4 py-6 text-center text-gray-500 italic">No orders found.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{# Include DataTables scripts #}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    $('#ordersTable').DataTable({
      pageLength: 10,
      order: [[1, 'desc']], // Sort by date by default
      language: {
        search: "_INPUT_",
        searchPlaceholder: "Search orders..."
      },
      columnDefs: [
        { orderable: false, targets: [2, 5] } // disable sorting on dishes + actions
      ]
    });
  });
</script>
{% endblock %}
