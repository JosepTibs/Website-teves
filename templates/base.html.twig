<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Le Fromage{% endblock %}</title>
    <link 
      rel="icon" 
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><text y='1.2em' font-size='96'>🧀</text></svg>"
    >
    
    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Brand Colors -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                gold: '#D4AF37',
                dark: '#0f0f0f',
                gray: '#1a1a1a',
              }
            }
          }
        }
      }
    </script>

    <style>
      :root {
        --brand-gold: #D4AF37;
        --text-light: #f5f5f5;
        --text-muted: #cfcfcf;
        --bg-dark: #0f0f0f;
        --bg-darker: #1a1a1a;
      }

      body {
        background-color: var(--bg-dark);
        color: var(--text-light);
        min-height: 100vh;
        background-image: 
          radial-gradient(circle at 20% 20%, rgba(255,255,255,0.04) 0%, transparent 40%),
          url('/images/logo-bg.png');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        background-attachment: fixed;
      }

      header, footer {
        background-color: rgba(26, 26, 26, 0.95);
        backdrop-filter: blur(6px);
      }

      .gold-gradient {
        background: linear-gradient(90deg, #d4af37 0%, #f5d76e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .card {
        background-color: rgba(30, 30, 30, 0.85);
        border: 1px solid rgba(212, 175, 55, 0.15);
        border-radius: 1rem;
        box-shadow: 0 0 10px rgba(212, 175, 55, 0.05);
      }
    </style>

    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--bg-dark)] text-white">

    <!-- Header -->
    <!-- Header -->
{% block header %}
<header class="border-b border-[var(--brand-gold)]/30 shadow-md">
  <div class="container mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-2xl font-semibold gold-gradient tracking-wider">
      Le Fromage
    </a>
    <nav class="space-x-6">
      <a href="/dashboard" class="text-[var(--text-muted)] hover:text-[var(--brand-gold)] transition">Dashboard</a>
      <a href="/menu" class="text-[var(--text-muted)] hover:text-[var(--brand-gold)] transition">Menu</a>
      <a href="/reservation" class="text-[var(--text-muted)] hover:text-[var(--brand-gold)] transition">Reservation</a>
      <a href="{{ path('app_login') }}" class="text-[var(--text-muted)] hover:text-[var(--brand-gold)] transition">Login</a>
    </nav>
  </div>
</header>
{% endblock %}


<!-- Main --> 
<div class="card p-8 shadow-xl"> 
{% block body %}{% endblock %} 
</div> 
<!-- Footer --> 
<footer class="border-t border-[var(--brand-gold)]/20 py-4 text-center text-sm text-[var(--text-muted)]"> 
&copy; {{ "now"|date("Y") }} 
<span class="text-[var(--brand-gold)] font-semibold">Le Fromage</span>. All rights reserved. 
</footer>

    {% block javascripts %}{% endblock %}
  </body>
</html>
